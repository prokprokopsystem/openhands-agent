# OpenHands Agent Canvas — переменные окружения
# Скопируйте этот файл в /srv/openhands-agent/secrets/.env
# Права на рабочем файле: chmod 600, владелец igor:igor

# === ОБЯЗАТЕЛЬНО ===
# Ключ для входа в Agent Canvas.
# Сгенерировать на mini-server: openssl rand -base64 32
LOCAL_BACKEND_API_KEY=your-generated-key-here

# === LLM ===
# Провайдер, API-ключ и модель настраиваются после первого входа
# через WebUI: Settings → LLM.
# Настоящий LLM API-ключ не записывать в GitHub.
