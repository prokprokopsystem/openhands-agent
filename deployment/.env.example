# OpenHands Agent Canvas — переменные окружения
# Скопировать: cp .env.example /srv/openhands-agent/secrets/.env
# Права: chmod 600 /srv/openhands-agent/secrets/.env
# Не добавлять в Git.

# API-ключ для доступа к Agent Canvas API
# Создать: openssl rand -base64 32 | tr -d '\n'
LOCAL_BACKEND_API_KEY=generate-with-openssl

# API-ключ DeepSeek для LLM
# Получить: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-deepseek-api-key

# LLM настраивается через шаблоны конфигурации (deployment/config/),
# а не через переменные окружения. Ключ подставляется скриптом seed-config.sh.
