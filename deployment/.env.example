# OpenHands Agent Canvas — переменные окружения
# Скопируйте этот файл в /srv/openhands-agent/secrets/.env и заполните значения

# === ОБЯЗАТЕЛЬНО ===
# API-ключ для доступа к Agent Canvas (сгенерируйте: openssl rand -base64 32)
LOCAL_BACKEND_API_KEY=your-generated-key-here

# === LLM-провайдер (выберите ОДИН вариант) ===

# Вариант 1: OpenAI
# LLM_API_KEY=sk-your-openai-key
# LLM_MODEL=gpt-4o
# LLM_BASE_URL=https://api.openai.com/v1

# Вариант 2: Anthropic
# LLM_API_KEY=sk-ant-your-anthropic-key
# LLM_MODEL=claude-sonnet-4-20250514
# LLM_BASE_URL=https://api.anthropic.com/v1

# Вариант 3: OpenRouter
# LLM_API_KEY=sk-or-your-openrouter-key
# LLM_MODEL=anthropic/claude-sonnet-4
# LLM_BASE_URL=https://openrouter.ai/api/v1

# === НЕ ЗАПОЛНЯТЬ (заполнит пользователь) ===
# Настоящие ключи НЕ хранить в этом файле — только в secrets/.env на сервере
