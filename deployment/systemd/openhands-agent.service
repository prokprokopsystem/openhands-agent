[Unit]
Description=OpenHands Agent Canvas
Documentation=https://github.com/prokprokopsystem/openhands-agent
After=network-online.target docker.service wg-quick@wg0.service
Requires=docker.service
Requires=wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes

# Проверить наличие 10.77.0.2
ExecStartPre=/bin/bash -c 'until ip addr show wg0 | grep -q 10.77.0.2; do sleep 2; done'

# Запустить Compose-проект
ExecStart=/usr/bin/docker compose -f /srv/openhands-agent/deployment/compose.yaml up -d

# Остановить Compose-проект
ExecStop=/usr/bin/docker compose -f /srv/openhands-agent/deployment/compose.yaml down

# Проверить health после запуска
ExecStartPost=/bin/bash -c 'for i in $(seq 1 30); do if curl -fsS -o /dev/null http://10.77.0.2:8000/canvas; then exit 0; fi; sleep 2; done; exit 1'

Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
