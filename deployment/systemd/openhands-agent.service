[Unit]
Description=OpenHands Agent Canvas
Documentation=https://github.com/prokprokopsystem/openhands-agent
After=network-online.target docker.service wg-quick@wg0.service
Requires=docker.service
Requires=wg-quick@wg0.service
Wants=network-online.target

[Service]
Type=simple

# Runtime-проверка перед каждым запуском (systemctl start, boot, restart)
ExecStartPre=/usr/bin/bash /srv/openhands-agent/deployment/scripts/validate-runtime.sh

# Supervised lifecycle: compose foreground + watchdog
ExecStart=/usr/bin/bash /srv/openhands-agent/deployment/scripts/run-supervised.sh

# Штатная остановка
ExecStop=/usr/bin/docker compose -f /srv/openhands-agent/deployment/compose.yaml down

Restart=on-failure
RestartSec=10

# Таймауты
TimeoutStartSec=180
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
